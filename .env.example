# =============================================================================
# COMP5521 HTLC — configuration template
# Copy to .env, fill the placeholders, and never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Networks (the two chains are independent; neither HTLC calls the other)
# -----------------------------------------------------------------------------
# Ethereum Sepolia: MST (ERC20) + ERC20HTLC
SEPOLIA_RPC_URL=
# Arbitrum Sepolia: native ETH + ETHHTLC
ARBITRUM_SEPOLIA_RPC_URL=

# Optional public endpoints if you do not have an RPC provider key:
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain IDs are checked before every write. They are fixed for the two
# testnets; only override these if you know exactly why.
SEPOLIA_CHAIN_ID=11155111
ARBITRUM_SEPOLIA_CHAIN_ID=421614

# -----------------------------------------------------------------------------
# 2. Accounts (32-byte private keys; 0x prefix optional; never commit them)
# -----------------------------------------------------------------------------
# Alice owns MST and receives ETH; Bob owns ETH and receives MST.
# The same two EOAs are used on both chains.
ALICE_PRIVATE_KEY=
BOB_PRIVATE_KEY=

# Optional deployer. If empty, the deploy command uses Alice.
DEPLOYER_PRIVATE_KEY=

# Read-only fallbacks used by `status` / `doctor` when a key is unavailable.
# They are not needed when the private keys above are set.
ALICE_ADDRESS=
BOB_ADDRESS=

# -----------------------------------------------------------------------------
# 3. Deployed contract addresses
# -----------------------------------------------------------------------------
# `node scripts/cli.js deploy` writes deployments/testnet.json; the scripts read
# addresses from that file if these variables are empty. Fill them manually if
# you prefer to keep the deployment record outside the repository.
MST_ADDRESS=
ERC20HTLC_ADDRESS=
ETHHTLC_ADDRESS=

# Only used by `deploy:mst` when the team has no MST yet. The official Lab 3
# MySimpleToken is deployed and the owner mints this amount to MST_MINT_TO
# (default: Alice). Leave empty to use Alice and 1,000,000 MST.
MST_MINT_TO=
MST_MINT_AMOUNT=1000000

# -----------------------------------------------------------------------------
# 4. Demo parameters
# -----------------------------------------------------------------------------
# MST amount is in token units (MST uses 18 decimals).
MST_LOCK_AMOUNT=100
# ETH amount is in native ETH.
ETH_LOCK_AMOUNT=0.01

# T_ETH must be shorter than T_MST. The safety gap gives the second claimant
# time to observe the revealed secret and confirm on the other chain.
ETH_TIMELOCK_SECONDS=900
MST_TIMELOCK_SECONDS=1800
MIN_TIMELOCK_GAP_SECONDS=300

# 1 is enough for a demo; use 2+ if you want extra reorg protection.
CONFIRMATIONS=1

# Minimum native balance the preflight requires for gas.
MIN_NATIVE_BALANCE=0.001

# Optional transaction timeout (milliseconds).
TX_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# 5. Local two-chain rehearsal (npm run local:demo sets these itself)
# -----------------------------------------------------------------------------
# LOCAL_ETH_RPC_URL=http://127.0.0.1:8545
# LOCAL_ARB_RPC_URL=http://127.0.0.1:8546
# LOCAL_ETH_CHAIN_ID=31337
# LOCAL_ARB_CHAIN_ID=421614
# LOCAL_MNEMONIC="test test test test test test test test test test test junk"
# Only needed to override the derived local accounts:
# LOCAL_ALICE_PRIVATE_KEY=
# LOCAL_BOB_PRIVATE_KEY=
