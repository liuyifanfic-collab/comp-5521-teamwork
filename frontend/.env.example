# 前端配置模板（只放公开信息，绝不放私钥）。复制为 .env.local 后填写。
# local = 本地双链 Mock（frontend/dev/deploy-local.cjs 生成 src/config.local.json）
# testnet = Ethereum Sepolia + Arbitrum Sepolia（地址由 D 部署后提供）
VITE_PROFILE=testnet

VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

VITE_ERC20HTLC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MST_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ETHHTLC_ADDRESS=0x0000000000000000000000000000000000000000

# 合约部署所在区块，用于查询 Claimed 事件（缩小日志查询范围）
VITE_SEPOLIA_DEPLOY_BLOCK=0
VITE_ARB_SEPOLIA_DEPLOY_BLOCK=0
